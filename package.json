{
  "name": "desktop-productivity-wallpaper",
  "version": "1.1.0",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main:compile\" \"npm run dev:electron\"",
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:main:compile": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 && electron dist/main/main.js --reload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "clean": "node scripts/clean-dist.js",
    "start": "electron dist/main/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Windows desktop productivity live wallpaper (Electron + React)",
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^11.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "build": {
    "appId": "com.samar.desktop-productivity-wallpaper",
    "productName": "DeskZen",
    "asar": true,
    "electronLanguages": ["en-US"],
    "removePackageScripts": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "electron-store/**/*",
          "auto-launch/**/*",
          "conf/**/*",
          "type-fest/**/*",
          "atomically/**/*",
          "dot-prop/**/*",
          "env-paths/**/*",
          "ajv/**/*",
          "ajv-formats/**/*",
          "fast-deep-equal/**/*",
          "fast-uri/**/*",
          "json-schema-traverse/**/*",
          "require-from-string/**/*",
          "semver/**/*",
          "uint8array-extras/**/*",
          "when-exit/**/*",
          "applescript/**/*",
          "untildify/**/*",
          "winreg/**/*",
          "path-is-absolute/**/*",
          "!**/*.md",
          "!**/*.txt",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/docs/**",
          "!**/.github/**",
          "!**/example/**",
          "!**/examples/**"
        ]
      },
      "package.json",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "win": {
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "compression": "maximum",
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
